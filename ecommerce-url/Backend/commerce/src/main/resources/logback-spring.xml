    <appender name="ASYNC_ROLLING_APPENDER" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="ROLLING_APPENDER"/>
        <discardingThreshold>0</discardingThreshold>
        <queueSize>512</queueSize>
    </appender>

